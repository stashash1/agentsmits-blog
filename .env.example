# agentsblog configuration (copy to .env, real values stay out of git)

# === Telegram ===
# Must match an accountId declared in channels.telegram.accounts in
# ~/.openclaw/openclaw.json. For agentsmits-blog agent the binding is
# `accountId: agentssmits_bot`, NOT `default` (default is blocked when
# its bot token duplicates another account's token).
AGENTSBLOG_TELEGRAM_ACCOUNT=agentssmits_bot
AGENTSBLOG_TELEGRAM_CHANNEL=telegram
AGENTSBLOG_TELEGRAM_TARGET=@agentsSmits
# Numeric chat_id of @agentsSmits main channel (skips getChat when set).
# Get it once via: curl 'https://api.telegram.org/bot<TOKEN>/getChat?chat_id=@agentsSmits'
AGENTSBLOG_TELEGRAM_CHAT_ID=-1003953773943

# === Direct Telegram Bot API (bypass openclaw CLI) ===
# When AGENTSBLOG_BOT_TOKEN_FILE is set, agentsblog.publishing.telegram
# uses urllib to call Telegram Bot API directly instead of spawning
# `openclaw message send`. Use this when openclaw's accountId-derived
# target is broken or sendRichMessage 404s.
# - File must contain the bot token on a single line (whitespace-trimmed)
# - File should be outside git (gitignore'd, e.g. data/bot_token.txt)
# - Recommended permissions: readable only by the publishing user
AGENTSBLOG_BOT_TOKEN_FILE=
AGENTSBLOG_TELEGRAM_CHAT_ID=

# === Quiet hours (MSK = UTC+3) ===
AGENTSBLOG_QUIET_HOURS_START=23
AGENTSBLOG_QUIET_HOURS_END=8
AGENTSBLOG_TZ_OFFSET=3

# === Paths ===
# All defaults resolve to <project_root>/{data,public}.
# Override here only for multi-tenant deploys.
AGENTSBLOG_ROOT=
AGENTSBLOG_DATA_DIR=
AGENTSBLOG_PUBLIC_DIR=

# === Publishing ===
AGENTSBLOG_MAX_PUBLISH_PER_RUN=5
AGENTSBLOG_EDITORIAL_REQUIRED=true
AGENTSBLOG_EDITORIAL_MIN_SCORE=75
AGENTSBLOG_EDITORIAL_MAX_AGE_DAYS=5
AGENTSBLOG_EDITORIAL_MAX_DAILY_POSTS=3
AGENTSBLOG_EDITORIAL_MIN_INTERVAL_MINUTES=180
AGENTSBLOG_EDITORIAL_ANALYSIS_BATCH=4
AGENTSBLOG_EDITORIAL_MODEL=qwen3:14b
AGENTSBLOG_EDITORIAL_REVIEW_MODEL=qwen3:14b
AGENTSBLOG_EDITORIAL_OLLAMA_URL=http://127.0.0.1:11434
AGENTSBLOG_TELEGRAM_PARSE_MODE=HTML   # HTML | MARKDOWN | None

# === Site ===
AGENTSBLOG_SITE_TITLE="AI Агенты Смита"
AGENTSBLOG_SITE_URL=https://stashash1.github.io/agentsmits-blog
AGENTSBLOG_RSS_LIMIT=20

# === AGI counter ===
AGENTSBLOG_AGI_BASE_DAYS=1460
AGENTSBLOG_AGI_START_DATE=2026-01-01

# === HTTP API (when installed with [api] extra) ===
AGENTSBLOG_API_HOST=127.0.0.1
AGENTSBLOG_API_PORT=8765
AGENTSBLOG_API_TOKEN=           # leave empty to disable auth (dev only)
